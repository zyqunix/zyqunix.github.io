{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    
    "allowJs": true,
    "noImplicitAny": false,
    "strict": false,
    
    // Environment Settings
    "module": "ES2022",
    "target": "ES2022",
    "types": [],
    
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    
    // Stricter Typechecking Options
    //"noUncheckedIndexedAccess": true,
    //"exactOptionalPropertyTypes": true,
    
    // Recommended Options
    //"strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
